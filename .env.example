# Coinbase Developer Platform Secret API Key.
# These credentials authenticate the server with Coinbase's production facilitator.
CDP_API_KEY_ID=your_cdp_secret_api_key_id
CDP_API_KEY_SECRET=your_cdp_secret_api_key_secret

# Your own EVM address for receiving USDC. The MCP server never needs its private key.
PAY_TO=0xYourBaseWalletAddress

# Base mainnet: eip155:8453. Base Sepolia: eip155:84532.
# Both use Coinbase's production facilitator; use Sepolia only for testing.
X402_NETWORK=eip155:8453

# Only needed by examples/client.ts, not by the receiving MCP server.
# This is a CDP Wallet Secret, not your receiving wallet private key.
CDP_WALLET_SECRET=your_cdp_wallet_secret
